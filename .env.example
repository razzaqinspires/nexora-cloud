# Local self-hosted mode. bootstrap.mjs generates secrets if missing/placeholders.
POSTGRES_DB=nexora
POSTGRES_USER=nexora_owner
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
NEXORA_APP_DB_USER=nexora_app
NEXORA_APP_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
NEXORA_ADMIN_TOKEN=REPLACE_WITH_RANDOM_SECRET
NEXORA_BACKUP_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET

# Domain and API docs resolve automatically from request / Vercel environment.
# Set this only after you own/configure an official hostname.
NEXORA_PUBLIC_URL=
NEXORA_LOCAL_PORT=3000
NEXORA_DATABASE_SSL=false
NEXORA_BACKUP_RETENTION_DAYS=30
NEXORA_BACKUP_INTERVAL_SECONDS=86400

# Vercel mode: set DATABASE_URL to an already-created persistent PostgreSQL DB.
# Optional migration settings for Vercel build environment:
# NEXORA_MIGRATE_ON_BUILD=true
# NEXORA_MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:5432/DB
# NEXORA_DATABASE_SSL=true

# Multi-database metrics agent. Keep the dashboard endpoint private or protect it with an access gateway.
NEXORA_METRICS_AGENT_API_KEY=REPLACE_WITH_RANDOM_SECRET
NEXORA_METRICS_INTERVAL_SECONDS=60
NEXORA_METRICS_PROVIDER=self-hosted
NEXORA_METRICS_LOCATION=primary-node
NEXORA_METRICS_PUBLIC=true # Self-hosted default is loopback-only; keep false on public Vercel deployments
# Optional: JSON array of additional PostgreSQL sources reachable from the agent host.
# NEXORA_METRIC_SOURCES_JSON=[{"sourceKey":"remote-vps-1","databaseUrl":"postgresql://...","provider":"vps-provider","location":"region-1","ssl":true}]
