# Copy to .env and replace every placeholder. Never commit .env.
# Database owner credentials are used only by PostgreSQL initialization/backup.
POSTGRES_DB=nexora
POSTGRES_USER=nexora_owner
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_HEX_PASSWORD

# Runtime app identity is deliberately a separate, non-superuser PostgreSQL role.
NEXORA_APP_DB_USER=nexora_app
NEXORA_APP_DB_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_HEX_PASSWORD

# Nexora admin bootstrap secret. Never send this to project clients.
NEXORA_ADMIN_TOKEN=REPLACE_WITH_AT_LEAST_64_HEX_CHARACTERS
