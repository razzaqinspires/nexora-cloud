# PostgreSQL connection string (Neon, Supabase, Railway, or another PostgreSQL provider)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Generate with: openssl rand -hex 32. Keep this only in Vercel server-side env vars.
NEXORA_ADMIN_TOKEN=replace-with-a-long-random-secret
# Optional display metadata
NEXT_PUBLIC_CLOUD_NAME=Nexora Cloud
